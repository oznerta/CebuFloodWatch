{
  "name": "cebufloodwatch-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Dual-platform flood warning and evacuation management system for Metro Cebu",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:mobile": "npm run dev --workspace=apps/mobile",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace=apps/api"
  },
  "keywords": [
    "disaster-response",
    "postgis",
    "flood-warning",
    "react-native",
    "nextjs",
    "cebu"
  ],
  "author": "CebuFloodWatch Team",
  "license": "MIT"
}
