PORT=5000
NODE_ENV=development

# Security & Initial Admin Credentials
JWT_SECRET=your_production_jwt_signing_secret_here
ADMIN_INITIAL_EMAIL=admin@cebucity.gov.ph
ADMIN_INITIAL_PASSWORD=cebucity2026

# Database
DATABASE_URL=postgresql://postgres:<PASSWORD>@<HOST>:5432/<DATABASE_NAME>?sslmode=require

# Firebase Admin
FIREBASE_PROJECT_ID=cebufloodwatch
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@cebufloodwatch.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# AI Model Provider Keys
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=<CLOUDINARY_CLOUD_NAME>
CLOUDINARY_API_KEY=<CLOUDINARY_API_KEY>
CLOUDINARY_API_SECRET=<CLOUDINARY_API_SECRET>

# Web Client
WEB_CLIENT_URL=http://localhost:3000
