# ==============================================================================
# CebuFloodWatch Environment Configuration Contract
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Networking
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
WEB_CLIENT_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. PostgreSQL + PostGIS Spatial Database
# ------------------------------------------------------------------------------
# Example: postgresql://postgres:yourpassword@db.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:<PASSWORD>@<HOST>:5432/<DATABASE_NAME>?sslmode=require

# ------------------------------------------------------------------------------
# 3. Firebase Admin SDK (Authentication & Disaster Push Notifications)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=cebufloodwatch
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@cebufloodwatch.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 4. AI Model API Keys (Configurable dynamically in Admin > AI Console)
# ------------------------------------------------------------------------------
# Google Gemini (Gemini 1.5 Flash / Pro)
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>

# Optional Alternative AI Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 5. Cloudinary Storage (Citizen Field Photo Evidence Verification)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=<CLOUDINARY_CLOUD_NAME>
CLOUDINARY_API_KEY=<CLOUDINARY_API_KEY>
CLOUDINARY_API_SECRET=<CLOUDINARY_API_SECRET>

# ------------------------------------------------------------------------------
# 6. Map & Vector Tile Services
# ------------------------------------------------------------------------------
NEXT_PUBLIC_MAPLIBRE_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
