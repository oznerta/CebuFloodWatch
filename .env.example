# CebuFloodWatch Environment Configuration Contract

# Server & Application
PORT=5000
NODE_ENV=development

# PostgreSQL + PostGIS Database
DATABASE_URL=postgresql://postgres:<PASSWORD>@<HOST>:5432/<DATABASE_NAME>?sslmode=require

# Firebase Admin (Auth & Push Messaging)
FIREBASE_PROJECT_ID=<FIREBASE_PROJECT_ID>
FIREBASE_CLIENT_EMAIL=<FIREBASE_CLIENT_EMAIL>
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<KEY_BODY>\n-----END PRIVATE KEY-----\n"

# Google Gemini AI (2.5 Flash)
GEMINI_API_KEY=<GEMINI_API_KEY>

# Cloudinary (Citizen Report Verification Media)
CLOUDINARY_CLOUD_NAME=<CLOUDINARY_CLOUD_NAME>
CLOUDINARY_API_KEY=<CLOUDINARY_API_KEY>
CLOUDINARY_API_SECRET=<CLOUDINARY_API_SECRET>

# Web Client URL & MapLibre Vector Style
WEB_CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_MAPLIBRE_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
